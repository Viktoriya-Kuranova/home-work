#include <iostream>
 using namespace std;
 
 int score=4;
 int main()
 {
    int score;
    cout<<"введите свой балл: "<<endl;
    cin>>score;
    if(score<0 || ::score<0 || score>(::score))
    {
		cout<<"данные введены некорректно\n "<<endl;
		return 0;
	}
	if(score<(::score))cout<<"ваш балл - "<<score<<" из "<< (::score)<<", желаемый результат не достигнут\n"<<endl;
	else cout<<"ваш результат - "<<score<<" из "<< (::score)<<", отлично, так держать!"<<endl;
	return 0;
 }
